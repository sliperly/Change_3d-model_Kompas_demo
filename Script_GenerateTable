# -*- coding: utf-8 -*-
import win32com.client
from win32com.client import Dispatch, gencache

def set_part_variables(file_path, new_values):
    """
    file_path: путь к .m3d детали
    new_values: dict {"ИмяПеременной": значение}
    """
    kompas_api7_module = gencache.EnsureModule(
        "{69AC2981-37C0-4379-84FD-5DD2F3C0A520}", 0, 1, 0
    )
    application = kompas_api7_module.IApplication(
        Dispatch("Kompas.Application.7")
    )
    application.HideMessage = 1  # ksHideMessageYes — авто-подтверждение диалогов

    documents = application.Documents
    doc = documents.Open(file_path, False, False)
    if not doc:
        print(f"Ошибка: не удалось открыть {file_path}")
        application.HideMessage = 0
        return False

    doc3d = kompas_api7_module.IKompasDocument3D(doc)
    top_part = doc3d.TopPart
    feature7 = kompas_api7_module.IFeature7(top_part)
    vars_obj = feature7.Variables(False, False)

    changed = False
    for v in vars_obj:
        if v.Name in new_values:
            v.Expression = str(new_values[v.Name])
            changed = True

    if changed:
        doc3d.RebuildDocument()
        doc.Save()

    doc.Close(1)
    application.HideMessage = 0
    return changed


def update_parts(sh, gl, vs, top_path, leg_path):
    ok1 = set_part_variables(top_path, {"Sh": sh, "Gl": gl})
    ok2 = set_part_variables(leg_path, {"Vs": vs})
    return ok1 and ok2


